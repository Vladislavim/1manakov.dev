Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Respect HTTPS terminated by the hosting provider's trusted reverse proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://imanakov.dev%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.imanakov\.dev$ [NC]
RewriteRule ^ https://imanakov.dev%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^play/?$ /lab [R=301,L]
RewriteRule ^journal(?:/(.*))?/?$ /guides/$1 [R=301,L]

# Preserve the existing extensionless canonical URLs; never use an SPA fallback.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [END]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
